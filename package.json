{
  "name": "digisay-platform",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "install:all": "pnpm --dir public install && pnpm --dir dashboard install",
    "dev": "pnpm run dev:public",
    "dev:public": "pnpm --dir public dev",
    "dev:dashboard": "pnpm --dir dashboard start",
    "dev:api": "dotnet run --project backend/src/DigiSay.Api --environment ASPNETCORE_ENVIRONMENT=Development -- --urls http://localhost:5080",
    "build": "pnpm run build:all",
    "build:all": "pnpm run build:public && pnpm run build:dashboard && pnpm run build:api",
    "build:public": "pnpm --dir public build",
    "build:dashboard": "pnpm --dir dashboard build",
    "build:api": "dotnet build backend/DigiSay.sln",
    "test": "pnpm run test:all",
    "test:all": "pnpm run test:public && pnpm run test:dashboard && pnpm run test:api",
    "test:public": "pnpm --dir public test",
    "test:dashboard": "pnpm --dir dashboard test",
    "test:api": "dotnet test backend/DigiSay.sln",
    "lint": "pnpm run lint:public",
    "lint:public": "pnpm --dir public lint"
  }
}
