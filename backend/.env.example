ASPNETCORE_URLS=http://localhost:5080
RateLimiting__RedisConnectionString=<managed-redis-connection-string>
RateLimiting__KeyHashSecret=<random-secret-at-least-32-bytes>
ForwardedHeaders__ForwardLimit=1
# Only set these to proxy addresses or CIDR ranges controlled by your deployment.
ForwardedHeaders__KnownProxies__0=<trusted-proxy-ip>
# ForwardedHeaders__KnownNetworks__0=<trusted-proxy-cidr>
ConnectionStrings__SqlServer=Server=<server>;Database=<database>;User Id=<user>;Password=<local-secret>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True
ConnectionStrings__SupabasePostgres=Host=aws-0-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.bepnnptewavnxuhhlcms;Password=<local-secret>;SSL Mode=Require
Email__Smtp__Host=<smtp-host>
Email__Smtp__Port=587
Email__Smtp__UserName=<smtp-username>
Email__Smtp__Password=<local-secret>
Email__Smtp__FromAddress=<verified-sender-address>
# Set briefly to provision the first confirmed SuperAdmin, then remove it.
Identity__BootstrapAdminSecret=<one-time-random-secret-at-least-32-bytes>
# AI is disabled by default. Enable only after provider/privacy/security gates are approved.
AI__PublicAssistant__Enabled=false
AI__OpenAI__Enabled=false
AI__OpenAI__Endpoint=https://api.openai.com/v1/responses
AI__OpenAI__Model=<approved-model>
AI__OpenAI__ApiKey=<store-in-user-secrets-or-managed-secret-store>
AI__OpenAI__TimeoutSeconds=15
AI__OpenAI__MaximumOutputTokens=400
